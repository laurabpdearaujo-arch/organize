{
  "name": "azeitona",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/db/** --exclude tests/api/**",
    "test:db": "vitest run tests/db tests/api --no-file-parallelism",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@hono/node-server": "^1.19.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.4",
    "lucide-react": "^1.59.0",
    "pdfjs-dist": "^5.7.284",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^7.9.4",
    "superjson": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@hono/vite-dev-server": "^0.23.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.11",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
