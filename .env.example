# Copie para .env (cp .env.example .env) e preencha. Nunca versionar o .env.
# Em desenvolvimento, o arquivo é o .env.local.

# Projeto Supabase (Project Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Postgres do Supabase pelo pooler em modo transação (porta 6543), com a senha do banco.
# O ?sslmode=require no fim liga o TLS: a lib postgres (postgres.js) conecta SEM criptografia por
# padrão. O app (src/db/index.ts) e as migrações já forçam TLS, mas mantenha o parâmetro aqui:
# qualquer outra ferramenta que use esta URL (psql, scripts) também precisa dele.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require

# Cadastro com código de convite (aba "Criar conta" na tela de entrada). Sem os DOIS, o cadastro fica fechado
# e as contas só são criadas pelo painel do Supabase.
#  - SIGNUP_CODE: o código que você passa para quem pode criar conta. Use algo longo e difícil de chutar
#    (ex.: azeitona-verde-2026-xyz); para "fechar as portas", troque ou apague.
#  - SUPABASE_SECRET_KEY (Project Settings → API Keys → secret): o servidor cria a conta com ela. Fica só no
#    servidor (nunca vai para o navegador). Também é usada pelos scripts e testes locais.
SIGNUP_CODE=
SUPABASE_SECRET_KEY=
