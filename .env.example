# Copie para .env (cp .env.example .env) e preencha. Nunca versionar o .env.
# Em desenvolvimento, o arquivo é o .env.local.

# Projeto Supabase (Project Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Postgres do Supabase pelo pooler em modo transação (porta 6543), com a senha do banco
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Só para scripts e testes locais (criar usuárias temporárias). NÃO é preciso na VPS.
# SUPABASE_SECRET_KEY=
